# Copy to .env beside deploy/compose.prod.yaml and fill in.

# The hostname Caddy will request a certificate for.
CLASSTRACK_DOMAIN=classtrack.example.edu

# Session signing key. Generate one:  openssl rand -hex 32
CLASSTRACK_JWT_SECRET=

# Monitoring rules. These are also editable in the UI at /admin/settings;
# the database value wins once set.
CLASSTRACK_MISSED_THRESHOLD_MINUTES=30
CLASSTRACK_TIMEZONE=Asia/Dhaka
